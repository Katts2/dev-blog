---
const { frontmatter } = Astro.props;
const { title, description, date } = frontmatter;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description ?? title} />
    <title>{title} | Dev Blog</title>
  </head>
  <body>
    <header>
      <a href="/">← 홈</a>
    </header>
    <main>
      <article>
        <p class="date">{date}</p>
        <h1>{title}</h1>
        {description && <p class="description">{description}</p>}
        <hr />
        <slot />
      </article>
    </main>
  </body>
</html>

<style is:global>
  :root {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: #202124;
    background: #f7f7f8;
    line-height: 1.7;
  }

  body {
    margin: 0;
  }

  header,
  main {
    width: min(860px, calc(100% - 32px));
    margin: 0 auto;
  }

  header {
    padding: 24px 0 8px;
  }

  header a {
    color: inherit;
    text-decoration: none;
  }

  article {
    background: white;
    padding: 32px;
    margin: 16px 0 64px;
    border-radius: 16px;
  }

  h1, h2, h3 {
    line-height: 1.3;
  }

  pre {
    overflow-x: auto;
    padding: 16px;
    background: #f1f3f5;
    border-radius: 10px;
  }

  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }

  .date {
    color: #6b7280;
    margin-bottom: 4px;
  }

  .description {
    color: #4b5563;
    font-size: 1.05rem;
  }

  @media (max-width: 600px) {
    article {
      padding: 20px;
    }
  }
</style>
