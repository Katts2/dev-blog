---
import '../styles/global.css';
import Header from '../components/Header.astro';

const { frontmatter } = Astro.props;
const { title, description, date } = frontmatter;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description ?? title} />
    <title>{title} | Dev Blog</title>
  </head>
  <body>
    <Header />
    <main>
      <article>
        <p class="date">{date}</p>
        <h1>{title}</h1>
        {description && <p class="description">{description}</p>}
        <hr />
        <slot />
      </article>
    </main>
  </body>
</html>

<style is:global>
  :root {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: #202124;
    background: #f7f7f8;
    line-height: 1.7;
  }

  body {
    margin: 0;
  }

   main {
    width: min(720px, calc(100% - 32px));
    margin: 0 auto;
  }

  article {
    padding: 56px 0 80px;
    margin: 0;
  }

  h1, h2, h3 {
    line-height: 1.3;
  }
 
 article > h1 {
  margin: 0;
  font-size: 2rem;
  font-weight: 650;
  line-height: 1.35;
  letter-spacing: -0.03em;
}

  pre {
    overflow-x: auto;
    padding: 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    line-height: 1.6;
  }

  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }

  :not(pre) > code {
  padding: 2px 6px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 6px;
  font-size: 0.9em;
}

  .date {
  margin: 0 0 12px;
  color: var(--text-muted);
  font-size: 0.8rem;
}

.description {
  margin: 12px 0 0;
  color: var(--text-muted);
  font-size: 0.95rem;
  line-height: 1.7;
  }

  @media (max-width: 768px) {
  main {
    width: calc(100% - 32px);
  }

  article {
    padding: 40px 0 56px;
  }

  article > h1 {
    font-size: 1.6rem;
  }

  .description {
    font-size: 0.9rem;
  }

  pre {
    padding: 14px;
    font-size: 0.85rem;
  }
}

article hr {
  margin: 32px 0 36px;
  border: 0;
  border-top: 1px solid var(--border);
}

article > :not(.date):not(.description):not(h1):not(hr) {
  max-width: 100%;
}

article p {
  line-height: 1.8;
}
</style>
