
---
import '../styles/global.css';
import Header from '../components/Header.astro';

const allPosts = Object.values(
  import.meta.glob('./blog/*.md', { eager: true })
) as any[];

const posts = allPosts
  .map((post) => ({
    title: post.frontmatter.title,
    description: post.frontmatter.description,
    date: post.frontmatter.date,
    href: post.url
  }))
  .sort((a, b) => {
    const dateDiff =
      new Date(b.date).getTime() - new Date(a.date).getTime();

    if (dateDiff !== 0) {
      return dateDiff;
    }

    return b.href.localeCompare(a.href);
  })
  .slice(0, 3);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="클라우드와 웹 개발을 배우며 프로젝트 진행 과정을 기록하는 개발 블로그" />
    <title>Dev Blog</title>
  </head>
<body>
    <Header />
    <main>
      <section class="hero">
        <p class="eyebrow">BEGINNER DEV LOG</p>
        <h1>안녕하세요. Mongku입니다.</h1>
        <p>
          개발 과정을 기록하는 블로그입니다..
        </p>
      </section>

      <section>
        <h2>최근 글</h2>
        <div class="posts">
          {posts.map((post) => (
            <a class="post" href={post.href}>
              <span>{post.date}</span>
              <h3>{post.title}</h3>
              <p>{post.description}</p>
            </a>
          ))}
        </div>
      </section>
    </main>
</body>
</html>

<style>
  main {
    width: min(960px, calc(100% - 32px));
    margin: 0 auto;
    padding: 56px 0 72px;
  }

  .hero {
    width: 720px;
    max-width: 100%;
    margin: 0 auto;
    padding: 24px 0 0;
  }

  .eyebrow {
    margin: 0 0 20px;
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  h1 {
    margin: 0 0 14px;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.02em;
  }

  .hero > p:last-child {
    max-width: 620px;
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .hero + section {
    max-width: 720px;
    margin: 200px auto 0;
  }

  h2 {
    margin: 0 0 18px;
    font-size: 1.15rem;
    line-height: 1.4;
  }

  .posts {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .post {
    position: relative;
    display: block;
    padding: 16px 48px 16px 16px;
    color: inherit;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .post:hover {
    background: var(--surface);
  }

  .post span {
    display: block;
    margin-bottom: 5px;
    color: var(--text-muted);
    font-size: 0.72rem;
  }

  .post h3 {
    margin: 0 0 4px;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .post p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .post::after {
    content: "›";
    position: absolute;
    top: 50%;
    right: 18px;
    transform: translateY(-50%);
    color: var(--text-muted);
    font-size: 1.6rem;
    font-weight: 300;
  }

  @media (max-width: 768px) {
    main {
      width: calc(100% - 32px);
      padding: 40px 0 56px;
    }

    h1 {
      font-size: 1.35rem;
    }

    .hero + section {
      margin-top: 56px;
    }

    .posts {
      max-width: none;
    }
  }
</style>